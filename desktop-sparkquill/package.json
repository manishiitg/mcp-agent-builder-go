{
  "name": "sparkquill-desktop",
  "version": "0.1.0",
  "description": "SparkQuill desktop app \u2014 family learning, on your own computer.",
  "main": "main.js",
  "private": true,
  "repository": "github:manishiitg/coding-agent-loop",
  "license": "UNLICENSED",
  "scripts": {
    "setup": "./dev-setup.sh",
    "test": "node --test lib/*.test.js",
    "start": "npx electron .",
    "build": "electron-builder --mac --arm64 --dir",
    "dist": "electron-builder --mac --arm64 --publish always"
  },
  "dependencies": {
    "agentworks-desktop-lib": "file:../desktop/lib",
    "detect-port": "^1.6.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sparkquill.desktop",
    "productName": "SparkQuill",
    "publish": [
      "github"
    ],
    "mac": {
      "icon": "resources/icons/icon.png",
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "extraResources": [
      {
        "from": "resources/agent-server",
        "to": "agent-server"
      },
      {
        "from": "resources/workspace-server",
        "to": "workspace-server"
      },
      {
        "from": "resources/lib",
        "to": "lib"
      },
      {
        "from": "resources/static",
        "to": "static"
      },
      {
        "from": "resources/configs",
        "to": "configs"
      },
      {
        "from": "resources/icons",
        "to": "icons"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "lib/agentEnv.js"
    ]
  }
}

[Unit]
Description=Update the coding-agent CLIs (Claude Code, Cursor, Codex, Pi) on a schedule
# Never race a release: the agent restart at the end of a deploy would find
# a half-installed CLI otherwise.
After=video-studio-agent.service

[Service]
Type=oneshot
EnvironmentFile=%h/video-studio/.env
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TOOLS_PREFIX=%h/.local
Environment=XDG_CONFIG_HOME=%h/.local/state/xdg-config
ExecStart=%h/video-studio/current/bin/update-coding-clis
StandardOutput=append:%h/video-studio/logs/cli-update.log
StandardError=append:%h/video-studio/logs/cli-update.log

# Deployment-managed, read-only secrets shared by all Video Studio projects.
# Copy to global-secrets.env (which is gitignored) and add only values that
# every project should be allowed to use.
#
# Values are never returned by the app. At runtime, a secret named FAL_KEY is
# available to the coding agent and production steps as SECRET_FAL_KEY.
#
# GLOBAL_SECRET_FAL_KEY=replace-me
# GLOBAL_SECRET_GEMINI_API_KEY=replace-me
